# Databricks Configuration
# Copy this file to .env and fill in your actual values

# Databricks Workspace Host URL
# Example: https://your-workspace.cloud.databricks.com
DATABRICKS_HOST=

# Databricks Access Token
# Create a token at: https://your-workspace.cloud.databricks.com/#setting/token
# For service account, use a service account token
DATABRICKS_TOKEN=

# Databricks SQL Warehouse ID
# Find this in Databricks SQL > SQL Warehouses > Click on warehouse > Warehouse ID
# Example: 1234567890abcdef
DATABRICKS_WAREHOUSE_ID=
